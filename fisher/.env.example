# ---------- 开关文件：复制为 .env，只改 APP_ENV ----------
# APP_ENV=dev
#
# ---------- 完整配置：复制本文件为 .env.dev / .env.staging / .env.prod ----------
# 加载顺序：.env → .env.{APP_ENV}
# 本地切换：改 .env 里的 APP_ENV 后重启进程
# 生产部署：优先用容器/平台注入环境变量，不必依赖本机 .env.prod

# 环境：dev / staging / prod
APP_ENV=dev

# isbn 查询 API key
AppKey=your_app_key_here

# MySQL
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/fisher?charset=utf8mb4

# JWT
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 邮箱
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_password

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# SQL 日志开关（prod 建议 false）
SQL_ECHO=false
